# Drizzle
# Local development only. Tests override this with an in-memory database.
DATABASE_URL=local.dev.db

# PM2 production only. Keep this separate from DATABASE_URL.
DATABASE_URL_PRODUCTION=data/production.db

# Canonical application host. Tenant previews use <site-key>.<host>.
PUBLIC_APP_HOST=saaskaya.com

# AI (M3+) — required for /new generation and the editor chat
ANTHROPIC_API_KEY=
# Optional overrides
# AI_MODEL=claude-opus-4-8
# AI_MONTHLY_TOKEN_LIMIT=500000

# Super admins (comma-separated) — can edit credentials at /admin/settings.
# Every other credential (Resend, Stripe, Porkbun, R2…) is managed THERE, in the DB.
ADMIN_EMAILS=

# Development only. Never enable in production.
AUTH_DEV_ECHO_LINK=
